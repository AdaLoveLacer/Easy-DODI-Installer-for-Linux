def find_casefold(folder: Path, name: str) -> Path | None:
    try:
        return next((p for p in folder.iterdir() if p.name.casefold() == name.casefold()), None)
    except OSError:
        return None


def package_files(folder: Path) -> tuple[Path, list[Path], list[Path]] | None:
    setup = find_casefold(folder, "setup.exe")
    if not setup:
        return None
    try:
        volumes = [p for p in folder.iterdir() if p.is_file() and p.suffix.casefold() == ".doi"]
    except OSError:
        return None
    required = [p for p in volumes if re.fullmatch(r"data\d+\.doi", p.name, re.I)]
    required.sort(key=lambda p: int(re.search(r"\d+", p.stem).group()))
    optional = sorted((p for p in volumes if p not in required), key=lambda p: p.name.casefold())
    if not required:
        return None
    return setup, required, optional


def discover(root: Path) -> list[Path]:
    found: list[Path] = []
    if not root.is_dir():
        return found
    for parent, dirs, _files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in {".git", "__pycache__", "Windows"}]
        folder = Path(parent)
        if package_files(folder):
            found.append(folder)
            dirs[:] = []
    return sorted(found, key=lambda p: str(p).casefold())


def run_capture(command: list[str], *, env: dict[str, str] | None = None) -> str:
    if not Path("/mnt/Eita").is_mount():
        raise DodiError("o volume Eita não está montado; temporários de análise não serão gravados no disco do sistema")
    PREFLIGHT_TMP.mkdir(parents=True, exist_ok=True)
    actual_env = (env or os.environ).copy()
    actual_env["TMPDIR"] = str(PREFLIGHT_TMP)
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, env=actual_env, check=False)
    if result.returncode:
        raise DodiError(f"comando terminou com código {result.returncode}: {' '.join(command)}\n{result.stdout[-4000:]}")
    return result.stdout


def list_archive(archive: Path) -> tuple[int, int, int, list[tuple[str, int]]]:
    output = run_capture([str(UNARC), "l", "--noarcext", str(archive)])
    match = re.search(r"([\d,]+) files?,\s*([\d,]+) bytes,\s*([\d,]+) compressed", output)
    if not match:
        raise DodiError(f"não consegui ler o resumo do arquivo FreeArc: {archive.name}")
    count, unpacked, packed = (int(s.replace(",", "")) for s in match.groups())
    entries: list[tuple[str, int]] = []
    directories = 0
    for line in output.splitlines():
        row = re.match(r"^\d{4}-\d\d-\d\d\s+\d\d:\d\d:\d\d\s+(-dir-|[\d,]+)\s+(.+)$", line)
        if row:
            name = row.group(2).replace("\\", "/")
            relative = PurePosixPath(name)
            if relative.is_absolute() or any(part in {"", ".", ".."} for part in relative.parts):
                raise DodiError(f"caminho inseguro no volume {archive.name}: {name}")
            if row.group(1) == "-dir-":
                directories += 1
            else:
                entries.append((name, int(row.group(1).replace(",", ""))))
    if len(entries) + directories != count:
        raise DodiError(f"listagem incompleta em {archive.name}: resumo informa {count} entradas, foram lidas {len(entries) + directories}")
    return count, unpacked, packed, entries


def verify_volume(archive: Path, staging: Path) -> None:
    count, _unpacked, _packed, entries = list_archive(archive)
    failures: list[str] = []
    root = staging.resolve()
    for name, expected_size in entries:
        output = staging.joinpath(*PurePosixPath(name).parts)
        try:
            resolved = output.resolve(strict=True)
            resolved.relative_to(root)
        except (OSError, ValueError):
            failures.append(f"ausente ou fora da pasta de destino: {name}")
            continue
        if not resolved.is_file():
            failures.append(f"não é arquivo: {name}")
        elif resolved.stat().st_size != expected_size:
            failures.append(f"tamanho divergente: {name} ({resolved.stat().st_size} != {expected_size})")
        if len(failures) >= 20:
            break
    if failures:
        raise DodiError(f"validação pós-extração falhou em {archive.name}:\n" + "\n".join(failures))
    print(f"[OK] {archive.name}: {count} arquivos presentes e com tamanho correto")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def source_identity(setup: Path, archives: list[Path]) -> dict[str, Any]:
    return {
        "setup_sha256": sha256(setup),
        "archives": {p.name: {"size": p.stat().st_size, "mtime_ns": p.stat().st_mtime_ns}
                     for p in archives},
    }


def ask_number(prompt: str, low: int, high: int, default: int | None = None) -> int:
    while True:
        suffix = f" [{default}]" if default is not None else ""
        raw = input(f"{prompt}{suffix}: ").strip()
        if not raw and default is not None:
            return default
        if raw.isdigit() and low <= int(raw) <= high:
            return int(raw)
        print(f"Escolha um número entre {low} e {high}.")


def choose_source(argument: Path | None) -> Path:
    if argument is None:
        for candidate in (Path.cwd(), Path(os.environ.get("DODI_LAUNCHER_DIR", str(ROOT)))):
            if package_files(candidate):
                return candidate.resolve()
    raw = str(argument) if argument is not None else ""
    if not raw:
        print(tr("DODI INSTALLER — informe o arquivo do pacote", "DODI INSTALLER — select the repack file"))
        print(tr("Use Setup.exe, um volume .doi ou a pasta que contém os arquivos.", "Enter Setup.exe, a .doi volume, or the folder containing the package files."))
        raw = input(tr("Arquivo ou pasta do pacote: ", "Package file or folder: ")).strip()
    if not raw:
        raise DodiError("nenhum arquivo ou pasta do pacote foi informado")
    path = Path(raw).expanduser().resolve()
    if not path.exists():
        raise DodiError(f"caminho não existe: {path}")
    folder = path if path.is_dir() else path.parent
    if not package_files(folder):
        raise DodiError(f"não encontrei Setup.exe e volumes dataN.doi junto de: {path}")
    return folder


def choose_destination(title: str) -> Path:
