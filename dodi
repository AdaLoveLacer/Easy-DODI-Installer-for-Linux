DIRECT_PLANS = {
    "e1184c8459ecf9e20a4dc87ba3dacf8993ccab8a03fa53856b8a2b50976ea36b": {
        "required": ["data1.doi", "data2.doi"], "optional": ["Wallpaper.doi"],
