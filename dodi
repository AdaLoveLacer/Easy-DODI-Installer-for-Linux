    roots.sort(key=lambda root: (root != Path("/mnt/Eita"), -shutil.disk_usage(root).free))
    if not roots:
        raise DodiError("não encontrei um disco de dados montado; o disco do sistema não será usado")
    choices = [root / "Games" / title for root in roots]
    print("\n╭── " + tr("DESTINO DA EXTRAÇÃO", "EXTRACTION DESTINATION") + " ──────────────────────────╮")
    for index, path in enumerate(choices, 1):
        print(f"  {index}. {path} — {shutil.disk_usage(path.parent.parent).free / 1024**3:.1f} GiB " + tr("livres", "free") + (" · " + tr("já existe", "already exists") if path.exists() else ""))
