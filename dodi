def yes_no(prompt: str, default: bool) -> bool:
    suffix = "S/n" if default else "s/N"
    while True:
        answer = input(f"{prompt} [{suffix}]: ").strip().casefold()
        if not answer:
            return default
        if answer in {"s", "sim", "y", "yes"}:
            return True
        if answer in {"n", "não", "nao", "no"}:
            return False


def atomic_json(path: Path, payload: dict[str, Any]) -> None:
    temporary = path.with_suffix(path.suffix + ".new")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


def wine_environment(prefix: Path) -> dict[str, str]:
    env = os.environ.copy()
    env.update({"WINEPREFIX": str(prefix), "WINEDEBUG": "-all", "WINEARCH": "win64"})
    return env


def host_to_wine(path: Path, prefix: Path) -> str:
    resolved = path.resolve()
    if str(resolved).startswith("/mnt/"):
        return "W:" + str(resolved)[4:].replace("/", "\\")
    winepath = shutil.which("winepath")
    if not winepath:
        raise DodiError("winepath não encontrado para converter o caminho do destino")
    return run_capture([winepath, "-w", str(resolved)], env=wine_environment(prefix)).strip().replace("\n", "")


def ensure_wine(prefix: Path, *, codecs_only: bool = False) -> tuple[str, dict[str, str]]:
    wine_path = PREFERRED_WINE if PREFERRED_WINE.is_file() else Path(shutil.which("wine") or "")
    if not wine_path.is_file():
        raise DodiError("Wine não encontrado; instale Wine ou disponibilize a build corrigida")
    wine = str(wine_path.resolve())
    env = wine_environment(prefix)
    if codecs_only:
        env["WINEDLLOVERRIDES"] = "mscoree,mshtml="
    env["TMPDIR"] = str(PREFLIGHT_TMP)
    env["XDG_CACHE_HOME"] = str(prefix.parent / "cache")
    prefix.mkdir(parents=True, exist_ok=True)
    if not (prefix / "system.reg").is_file():
        wineboot_path = wine_path.parent / "wineboot"
        wineboot = str(wineboot_path) if wineboot_path.is_file() else shutil.which("wineboot")
        if wineboot:
            run_capture([wineboot, "-i"], env=env)
        else:
            run_capture([wine, "wineboot.exe", "-i"], env=env)
    return wine, env


def map_drive(prefix: Path, letter: str, target: Path) -> None:
    link = prefix / "dosdevices" / f"{letter.casefold()}:"
    link.parent.mkdir(parents=True, exist_ok=True)
    if link.is_symlink():
        if link.resolve() == target.resolve():
            return
        raise DodiError(f"a unidade {letter.upper()}: já aponta para outro caminho: {link.resolve()}")
    if link.exists():
        raise DodiError(f"a unidade {letter.upper()}: já existe e não é link simbólico")
    link.symlink_to(target.resolve())


def folder_metrics(folder: Path) -> tuple[int, int]:
    total = files = 0
    if not folder.is_dir():
        return total, files
    for parent, dirs, names in os.walk(folder, followlinks=False):
        dirs[:] = [name for name in dirs if not (Path(parent) / name).is_symlink()]
        for name in names:
            path = Path(parent) / name
            try:
                if path.is_file() and not path.is_symlink():
                    total += path.stat().st_size
                    files += 1
            except OSError:
                continue
    return total, files


def select_codec_drive(prefix: Path, workdir: Path) -> str:
    links = prefix / "dosdevices"
    for letter in "RSTUVWXYZ":
        link = links / f"{letter.lower()}:"
        if link.is_symlink() and link.resolve() == workdir.resolve():
            return f"{letter}:"
        if not link.exists() and not link.is_symlink():
            link.symlink_to(workdir)
            return f"{letter}:"
    raise DodiError("nenhuma letra de unidade livre para o diretório temporário dos codecs")


def run_freearc(action: str, archive: Path, staging: Path, workdir: Path,
                runtime: Path, prefix: Path, wine: str, env: dict[str, str],
                log_path: Path) -> None:
    codec_drive = select_codec_drive(prefix, workdir)
    source_win = host_to_wine(archive, prefix)
    target_win = host_to_wine(staging, prefix)
    runtime_win = host_to_wine(runtime, prefix)
    work_win = f"{codec_drive}\\"
    command = [wine, str(HELPER), runtime_win + "\\unarc.dll", action, "-o+",
               "-dp" + target_win, "-w" + work_win,
               "-cfg" + runtime_win + "\\arc.ini", source_win, "", "", "", ""]
    print(f"[{action.upper()}] {archive.name}")
    with log_path.open("a", encoding="utf-8", errors="replace") as log:
        process = subprocess.Popen(command, cwd=runtime, env=env, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, errors="replace",
                                   bufsize=1)
        assert process.stdout is not None
        for line in process.stdout:
            log.write(line)
            if line.startswith("[FreeArc] event=") or "error" in line.casefold() or "crc" in line.casefold():
                print(line.rstrip())
        code = process.wait()
        log.flush()
        os.fsync(log.fileno())
    final = re.findall(r"\[FreeArc\] final rc=(-?\d+)", log_path.read_text(encoding="utf-8", errors="replace"))
    if code != 0 or not final or final[-1] != "0":
        raise DodiError(f"FreeArc {action} falhou em {archive.name} (processo {code}; ver {log_path})")


